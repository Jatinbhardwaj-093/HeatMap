{
  "name": "trackheat",
  "version": "1.0.0",
  "description": "High-density binary habit matrix engine inspired by GitHub contribution graphs",
  "author": "Jatin Bhardwaj",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop": "npm run dev:desktop",
    "dev:desktop": "concurrently -k \"npx expo start --web --port 8081\" \"wait-on http://localhost:8081 && electron electron/main.js\"",
    "build:mac": "npx expo export -p web && electron-builder --mac",
    "build:apk": "npx eas-cli build -p android --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~6.0.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.trackheat.app",
    "productName": "TrackHeat",
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "assets/icon.png",
      "package.json"
    ]
  },
  "private": true
}
