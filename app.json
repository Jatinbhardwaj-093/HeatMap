{
  "expo": {
    "name": "TrackHeat",
    "slug": "trackheat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#090A0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackheat.tracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090A0C"
      },
      "package": "com.trackheat.tracker"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TrackHeatWidget",
              "label": "TrackHeat Matrix",
              "minWidth": "160dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Daily habit contribution matrix",
              "previewImage": "./assets/icon.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bf103ae8-bb59-4d7a-88b4-e15e14f18a4e"
      }
    }
  }
}
